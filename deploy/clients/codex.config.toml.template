#
# OpenAI Codex CLI — add to ~/.codex/config.toml
# Direct to the MCP server at {{MINERU_MCP_URL}}:

[mcp_servers.mineru]
url = "{{MINERU_MCP_URL}}/mcp"
startup_timeout_sec = 20
tool_timeout_sec = 600          # parse jobs can run long; query_job_status polls

# --- Alternative: via liteLLM proxy ---
# [mcp_servers.mineru_selfhosted]
# url = "{{LITELLM_MCP_URL}}"
# http_headers = { "Authorization" = "Bearer sk-…" }
# NOTE: through the gateway tool names are prefixed (mineru_selfhosted-…);
# direct {{MINERU_MCP_URL}}/mcp uses unprefixed names.

# --- If MINERU_MCP_TOKEN is set on the server ---
# http_headers = { "Authorization" = "Bearer change-me" }

