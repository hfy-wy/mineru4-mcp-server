# =====================================================================
# Environment profile: PROD  (正式部署服务器 192.168.210.251 — the same
# host that runs the MinerU router :8002 / api-server :8000)
#
# These are the ONLY places endpoint IPs live. All deploy templates
# (systemd env, docker-compose, litellm snippet, client configs, skills)
# are rendered FROM these variables — switch test/prod by pointing
# scripts/render_env.sh at the right profile.
# =====================================================================

# --- MinerU backend (V1 router :8002 -> api-server :8000, same host) ---
MINERU_BASE_URL=http://192.168.210.251:8002

# --- MCP server surfaces (the :7000 host) ---
MINERU_MCP_HOST=192.168.210.251
MINERU_MCP_PORT=7000
MINERU_MCP_URL=http://192.168.210.251:7000
MINERU_UPLOAD_URL=http://192.168.210.251:7000/upload
MINERU_DOWNLOADS_URL=http://192.168.210.251:7000/downloads
MINERU_BOARD_URL=http://192.168.210.251:7000/ui

# --- liteLLM gateway (196.127:4000) — URL identical for both profiles; the
#     mcp_servers entry's `url:` underneath changes with the profile ---
LITELLM_MCP_URL=http://192.168.196.127:4000/mineru_selfhosted/mcp
LITELLM_API_KEY=sk-NJRSEvuX8XGZ680RQYz-Zw

# --- User identity tag for the journal / board (X-Mineru-User) ---
MINERU_USER_LABEL=prod

# =====================================================================
# Server-side runtime settings (same as deploy/systemd/mineru-mcp.env)
# =====================================================================
MINERU_UPLOAD_DIR=/var/lib/mineru-mcp/uploads
MINERU_OUTPUT_DIR=/var/lib/mineru-mcp/output
# PUBLIC_BASE_URL must be the host reachable by agents for upload/download
MINERU_PUBLIC_BASE_URL=http://192.168.210.251:7000
MINERU_MAX_UPLOAD_BYTES=209715200
MINERU_MAX_FILES_PER_JOB=100
MINERU_UPLOAD_TTL_SECONDS=86400
MINERU_POLL_TIMEOUT_SECONDS=3600
MINERU_LOG_LEVEL=INFO
# Journal: PostgreSQL on the prod host (local for the service process)
# Create db first: CREATE DATABASE mineru_mcp;
# NOTE db name spelling: PROD uses mineru_mcp (underscore) while the WSL TEST
# environment uses mineru-mcp (hyphen, historical). Code is agnostic (DSN is
# passed to psycopg verbatim) — only DSN-vs-actual-db must match per env.
MINERU_PG_DSN=postgresql://mineru:mineru@127.0.0.1:5432/mineru_mcp
MINERU_WEBUI_ENABLED=1
