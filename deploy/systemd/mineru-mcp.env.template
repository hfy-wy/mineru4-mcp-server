# /etc/mineru-mcp.env — systemd EnvironmentFile for mineru-mcp.service
# TEMPLATE — rendered by scripts/render_env.sh from deploy/env/{test,prod}.env
# into deploy/generated/mineru-mcp.env.<mode>.generated (gitignored).
# Copy the rendered file to /etc/mineru-mcp.env on {{MINERU_MCP_HOST}}.

# MinerU router (V1 gateway) — MCP server talks to THIS, router proxies api-server :8000
MINERU_BASE_URL={{MINERU_BASE_URL}}

# Bearer for the router/api-server, only when started with --api-key
#MINERU_API_KEY=change-me

# Bearer guarding /mcp + /upload (intranet shared secret; also set it in
# client headers / liteLLM auth). Leave unset for an open intranet service.
#MINERU_MCP_TOKEN=change-me

# Storage
MINERU_UPLOAD_DIR=/var/lib/mineru-mcp/uploads
MINERU_OUTPUT_DIR=/var/lib/mineru-mcp/output

# Public base for download_url / upload hints in tool responses.
# Stays :7000 even when MCP traffic goes through the liteLLM proxy.
MINERU_PUBLIC_BASE_URL={{MINERU_PUBLIC_BASE_URL}}

# Limits
MINERU_MAX_UPLOAD_BYTES=209715200
MINERU_MAX_FILES_PER_JOB=100
MINERU_UPLOAD_TTL_SECONDS=86400
MINERU_POLL_TIMEOUT_SECONDS=3600
MINERU_LOG_LEVEL=INFO

# Job journal + web board (F6): multi-user parse task records in PostgreSQL.
# Tables auto-create on startup.
# DB name: PROD = mineru_mcp (underscore); the WSL TEST env uses mineru-mcp
# (hyphen, historical). Code is agnostic — DSN must match the actual db name.
MINERU_PG_DSN={{MINERU_PG_DSN}}
# Board at {{MINERU_BOARD_URL}} (exempt from bearer auth, read-only)
MINERU_WEBUI_ENABLED=1
