[Unit]
Description=MinerU Self-Hosted MCP server (MinerU 4.0 V1 API bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mineru
Group=mineru
WorkingDirectory=/opt/mineru-selfhosted-mcp
EnvironmentFile=/opt/mineru-selfhosted-mcp/deploy/systemd/mineru-mcp.env
ExecStart=/opt/mineru-selfhosted-mcp/.venv/bin/mineru-selfhosted-mcp \
    --transport streamable-http --host 0.0.0.0 --port 7000
Restart=on-failure
RestartSec=5

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mineru-mcp

[Install]
WantedBy=multi-user.target
